# Normalize line endings to LF (matches .editorconfig).
* text=auto eol=lf
*.png binary
*.age binary
*.tar.gz binary
# The web UI's vendored Tabler files are committed byte for byte as upstream
# ships them and pinned by MANIFEST.sha256, so git must not normalize them.
src/internal/web/assets/vendor/** -text -diff linguist-vendored
