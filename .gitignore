# secrets / runtime state: NEVER commit. The real per-user home is ~/.sshmgr
# (outside the repo); config/ here is only the example manifest + schemas.
.env
config/.env
**/age-identity.txt
**/*-identity.txt
*.age
*.age.sha256
*.age.contents
config/log/
config/snapshots/
config/.state/
# runtime state that older builds wrote into ./config (now under ~/.sshmgr)
config/.lock
config/.expiry-cache.json
config/.notify-cache.json
config/audit.log

# generated ~/.ssh is NOT in this repo; if you also version it via chezmoi,
# allowlist only *.pub and config there, never private keys.

# Leftovers from the Python implementation, removed at the `python-final` tag.
# Nothing here is created any more; the entries stay so that a working copy that
# caches may still sit in a working copy that predates its removal. (dist/ is
# kept regardless - GoReleaser writes there.)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.pyc

# os / editor / tooling
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# Shipping checklist is a personal release-prep aid, never tracked
docs/shipping-checklist.md

# Per-machine ssh reconciliation worklist, never tracked
docs/ssh-worklist.md

# ai-cleanup tool artifacts (never tracked)
reports/
cleaned/
*.bak

# Go
/sshmgr
/sshmgr.exe
*.test
/vendor/

# Go release build outputs (build/targets.txt is tracked; build/dist/ is generated
# by GoReleaser and scripts/build-all.sh).
/build/dist/


# Local build output (make build)
bin/
