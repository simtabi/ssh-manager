{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ssh-manager manifest",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_type": {
          "type": "string"
        },
        "key_scope": {
          "enum": [
            "per_service",
            "shared"
          ]
        },
        "rotate_after_days": {
          "type": "integer"
        },
        "warn_before_days": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "expiry_check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "debounce_hours": {
              "type": "integer"
            },
            "desktop_notify": {
              "type": "boolean"
            }
          }
        },
        "global_options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "onepassword_agent": {
          "type": "string",
          "description": "1Password SSH agent socket for key_store 1password profiles; empty = the platform default."
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "description": "sshmgr git: default remote mode, default identity, and owner-to-profile map.",
          "properties": {
            "mode": {
              "enum": [
                "profile",
                "ssh",
                "https"
              ]
            },
            "profile": {
              "type": "string",
              "description": "Default identity; its GitHub key is bound to the rendered Host github.com."
            },
            "orgs": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "GitHub owner -> profile."
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_scope": {
            "enum": [
              "per_service",
              "shared"
            ]
          },
          "key_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alias",
                "hostname",
                "user"
              ],
              "properties": {
                "alias": {
                  "type": "string"
                },
                "hostname": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "default": 22
                },
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "token_env": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "key_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires_vpn": {
                  "type": "boolean",
                  "description": "Host is only reachable over a VPN."
                },
                "vpn_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Which VPN (shown in the reachability hint)."
                },
                "vpn_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Where to connect that VPN (shown in the hint)."
                },
                "raw_options": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "vm": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hypervisor",
                    "name"
                  ],
                  "description": "A local VM: its address comes from the hypervisor at connect time.",
                  "properties": {
                    "hypervisor": {
                      "enum": [
                        "parallels",
                        "vmpal",
                        "vmware",
                        "utm",
                        "lima"
                      ]
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "proxy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "description": "Route connections through a proxy command sshmgr renders: cloudflared reaches the host through Cloudflare Access (ssh runs `cloudflared access ssh --hostname %h`). A host is a VM or proxied, not both.",
                  "properties": {
                    "kind": {
                      "enum": [
                        "cloudflared"
                      ]
                    }
                  }
                }
              }
            }
          },
          "category": {
            "type": "string",
            "description": "Groups the profile under profiles/<category>/."
          },
          "key_store": {
            "enum": [
              "file",
              "1password"
            ]
          },
          "op_vault": {
            "type": "string",
            "description": "1Password vault for key_store 1password."
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rotate_after_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
